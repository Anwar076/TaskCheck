# systemd user service — TaskCheck SEO Agent 24/7
#
# 1. Pas hieronder REPO aan naar je eigen Plesk git-clone (NIET httpdocs).
#    Vind het pad met:  ls -d ~/git/*/
# 2. Kopieer naar ~/.config/systemd/user/taskcheck-seo-agent.service
# 3. Zorg dat de service blijft draaien zonder actieve SSH-sessie:
#       loginctl enable-linger $USER
#    Zonder lingering stopt systemd --user zodra je uitlogt.
# 4. systemctl --user daemon-reload
#    systemctl --user enable --now taskcheck-seo-agent
#    systemctl --user status taskcheck-seo-agent
#    journalctl --user -u taskcheck-seo-agent -f
#
# Werkt systemctl --user niet op je Plesk-abonnement? Gebruik dan
# scripts/plesk-daemon.sh via een cron-regel (@reboot en elke 5 min);
# de single-instance lock voorkomt dubbele processen.

[Unit]
Description=TaskCheck SEO Agent (Telegram 24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/git/laravel_e55cd2/taskcheck-seo-agent
Environment=GIT_REPO_ROOT=%h/git/laravel_e55cd2
Environment=PUBLISH_MODE=git_only
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/git/laravel_e55cd2/taskcheck-seo-agent/venv/bin/python run.py daemon
Restart=always
RestartSec=15

# Exitcode 3 = "er draait al een instantie"; herstarten heeft dan geen zin.
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
