# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Telegram
TELEGRAM_TOKEN=...
CHAT_ID=...
OWNER_NAME=Anwar

# Google Search Console
GSC_SITE_URL=sc-domain:taskcheck.nl
GSC_CREDENTIALS=credentials.json

# Scheduler
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=0

# Agent gedrag — git_only = wijzigingen ALLEEN via git (nooit direct httpdocs)
AUTO_PUBLISH=false
PUBLISH_MODE=git_only
GIT_BASE_BRANCH=main
GIT_REMOTE=origin
GIT_AUTO_COMMIT=true

# 24/7 server: pad naar Plesk git clone (NIET httpdocs)
# Plesk: GIT_REPO_ROOT=/var/www/vhosts/taskcheck.nl/git/laravel_e55cd2
# Docker: GIT_REPO_ROOT=/repo
# Windows: leeg laten (auto: C:\laragon\www\surveycams)
GIT_REPO_ROOT=

# 24/7 gedrag (gebruik: python run.py daemon)
PROACTIVE_ALERTS=true
OPPORTUNITY_ALERT_INTERVAL_HOURS=6
OPPORTUNITY_ALERT_COOLDOWN_HOURS=24
DAILY_AUTO_ACTION=true

# Discovery & Google Search Console na publicatie
SITEMAP_PUBLIC_URL=https://taskcheck.nl/sitemap.xml
GSC_SUBMIT_SITEMAP=true
GSC_INSPECT_URLS=true
AUTO_GSC_AFTER_PUSH=true
AUTO_GSC_ON_DIRECT_PUBLISH=true

# GSC analyse-periode (standaard = maand)
GSC_DEFAULT_DAYS=28
GSC_TREND_DAYS=14

# Concurrentie-analyse (0 = alle domeinen uit config/competitors.txt)
COMPETITOR_MAX_RESULTS=0
