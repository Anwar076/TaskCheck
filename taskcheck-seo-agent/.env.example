# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Telegram
TELEGRAM_TOKEN=...
CHAT_ID=...
OWNER_NAME=Anwar

# Google Search Console
GSC_SITE_URL=sc-domain:taskcheck.nl
GSC_CREDENTIALS=credentials.json

# Scheduler
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=0

# Agent gedrag
AUTO_PUBLISH=false
PUBLISH_MODE=git_only
GIT_BASE_BRANCH=main
GIT_REMOTE=origin
GIT_AUTO_COMMIT=true

# 24/7 gedrag (gebruik: python run.py daemon)
PROACTIVE_ALERTS=true
OPPORTUNITY_ALERT_INTERVAL_HOURS=6
OPPORTUNITY_ALERT_COOLDOWN_HOURS=24
DAILY_AUTO_ACTION=true

# Discovery & Google Search Console na publicatie
SITEMAP_PUBLIC_URL=https://taskcheck.nl/sitemap.xml
GSC_SUBMIT_SITEMAP=true
GSC_INSPECT_URLS=true
AUTO_GSC_AFTER_PUSH=true
AUTO_GSC_ON_DIRECT_PUBLISH=true
