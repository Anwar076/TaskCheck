APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Super admin (comma-separated; users must have role admin)
SUPER_ADMIN_EMAILS=

# Mail tracklinks (/go/{code})
MARKETING_LINK_DEFAULT_URL=https://taskcheck.nl

# Platform monitoring e-mail alerts
PLATFORM_ALERTS_ENABLED=true
PLATFORM_ALERT_EMAIL=
PLATFORM_ALERT_ACTIVE_USERS_THRESHOLD=100
PLATFORM_ALERT_ACTIVE_SESSIONS_THRESHOLD=150
# Alleen recent bijgewerkte in_progress inzendingen (niet alle openstaande checklists)
PLATFORM_ALERT_SUBMISSIONS_IN_PROGRESS_THRESHOLD=50
PLATFORM_ALERT_SUBMISSIONS_ACTIVITY_WINDOW_MINUTES=60
PLATFORM_ALERT_SUBMISSIONS_MIN_ACTIVE_USERS=5
PLATFORM_ALERT_PENDING_JOBS_THRESHOLD=50
PLATFORM_ALERT_FAILED_JOBS_THRESHOLD=5
PLATFORM_ALERT_COOLDOWN_MINUTES=60
PLATFORM_ALERT_SESSION_WINDOW_MINUTES=15

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
# Laat MAIL_URL leeg tenzij je één DSN gebruikt. Een gezet MAIL_URL (vaak door Plesk)
# overschrijft MAIL_USERNAME / MAIL_PASSWORD — dan zie je in logs bv. username "Taskcheck" (APP_NAME).
MAIL_URL=
# Voor smtp.gmail.com: het volledige Google-mailadres (Workspace of Gmail), géén weergavenaam.
# Fout die je anders krijgt: 535 BadCredentials met username "Taskcheck" of je bedrijfsnaam.
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional: inbox for /contact (defaults to MAIL_FROM_ADDRESS)
MAIL_CONTACT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AI_IMPORT_TIMEOUT=45
OPENAI_AI_IMPORT_MAX_TOKENS=8000

MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=

VAPID_SUBJECT="mailto:hello@taskcheck.nl"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# iOS lockscreen push (Capacitor App Store / TestFlight). .p8 key from Apple Developer → Keys.
APNS_ENABLED=false
APNS_PRODUCTION=true
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=nl.brancom.taskcheck
APNS_PRIVATE_KEY=
# Or a readable path to AuthKey_XXXXXX.p8 instead of APNS_PRIVATE_KEY:
# APNS_PRIVATE_KEY_PATH=

# Android lockscreen push (Capacitor + Firebase). Service account from Firebase → Project settings.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Mobile API (Expo / taskcheck-app) — Laravel Sanctum Bearer tokens (no API key)
# -----------------------------------------------------------------------------
# Comma-separated origins for CORS (Expo dev server + optional production web).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Public URL of this Laravel app (used for proof file URLs, etc.)
# APP_URL is already set above; ensure it matches your Laragon host, e.g. http://surveycams.test
# Optional: disable Expo push delivery (defaults to enabled when tokens exist)
# EXPO_PUSH_ENABLED=true

# Google reCAPTCHA v3 (contact form)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# Crisp live chat (public marketing pages)
CRISP_WEBSITE_ID=
